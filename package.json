{
  "name": "SecurityPlus",
  "version": "1.0.2",
  "description": "Bezpečnostný systém pre domový monitoring",
  "author": "Adam Humaj",
  "main": "main.js",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "electron": "electron .",
    "dev": "vite & electron .",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.securityplus",
    "productName": "SecurityPlus",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/serialport/build/Release",
        "to": "serialport",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "vite": "^5.0.0"
  }
}
